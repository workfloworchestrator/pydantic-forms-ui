{
    "name": "pydantic-forms",
    "version": "4.2.0",
    "description": "Library that turns JSONSchema into frontend forms",
    "author": {
        "name": "Workflow Orchestrator Program",
        "email": "workfloworchestrator.board@commonsconservancy.org",
        "url": "https://www.workfloworchestrator.org"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workfloworchestrator/pydantic-forms-ui.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "homepage": "https://www.workfloworchestrator.org",
    "bugs": "https://github.com/workfloworchestrator/pydantic-forms-ui/issues",
    "keywords": [
        "orchestrator",
        "workflow",
        "workflow orchestrator",
        "pydanticforms",
        "forms",
        "jsonschema"
    ],
    "browser": "./dist/index.js",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "Apache-2.0",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsup src/index.tsx --format esm,cjs --dts --external react",
        "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react",
        "lint": "eslint \"src/**/*.ts*\"",
        "tsc": "tsc --noEmit",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
    },
    "devDependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@jest/globals": "^30.5.2",
        "@orchestrator-ui/eslint-config-custom": "^2.2.0",
        "@orchestrator-ui/jest-config": "^1.7.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.0.2",
        "next-intl": "^4.14.6",
        "react-hook-form": "^7.77.0",
        "swr": "^2.4.1",
        "ts-jest": "^29.4.6",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "zod": "^4.3.6"
    },
    "dependencies": {
        "@apidevtools/json-schema-ref-parser": "^16.0.3",
        "dayjs": "^1.11.19",
        "i18next": "^26.4.2",
        "lodash": "^4.17.23"
    },
    "peerDependencies": {
        "@hookform/resolvers": "^5.2.2",
        "next-intl": "^4.14.6",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0",
        "react-hook-form": "^7.77.0",
        "swr": "^2.4.1",
        "zod": "^4.3.6"
    }
}
